<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ site.description }}">
  <meta name="theme-color" content="#f5f4ee">
  <title>{{ site.name }} — libsrc.dev</title>
  <link rel="canonical" href="{{ site.url }}/">
  <meta property="og:title" content="{{ site.name }} — libsrc.dev">
  <meta property="og:description" content="{{ site.description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}/">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/style.css">
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="shell">
    <header>
      <a class="wordmark" href="/" aria-label="{{ site.name }} home">libsrc<span class="muted">.dev</span></a>
      <a class="header-link" href="{{ site.github }}">GitHub <span aria-hidden="true">↗</span></a>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="intro">
        <p class="eyebrow"><span class="dot" aria-hidden="true"></span> Independent open source</p>
        <h1 id="intro" class="library-title">So<span class="spell">[u]</span>rce<span class="spell">[ry]</span><br><span class="source">Library.</span></h1>
        <p class="intro">My misc toolbox, a mix of libs, micro-services, APIs, templates &amp; utils.</p>
        <a class="button" href="{{ site.github }}">Browse the repositories <span aria-hidden="true">↗</span></a>

      </section>
      <section class="projects" aria-labelledby="projects">
        <div class="section-heading"><h2 id="projects">From the collection</h2><span class="eyebrow">01 / Selected repositories</span></div>
        <div class="grid">
          {% for project in site.projects %}
          <a class="project" href="{{ project.url }}">
            <div class="project-top"><span class="category">{{ project.category }}</span><span class="arrow" aria-hidden="true">↗</span></div>
            <h3>{{ project.name }}</h3>
            <p>{{ project.description }}</p>
            <span class="project-bottom">View source <span aria-hidden="true">→</span></span>
          </a>
          {% endfor %}
        </div>
      </section>
      <section class="closing" aria-labelledby="contribute"><div><p class="eyebrow">Issues & contributions</p><h2 id="contribute">Found something to improve?</h2><p>Bug reports, questions, and pull requests belong in each project’s repository.</p></div><a class="text-link" href="{{ site.github }}">All repositories <span aria-hidden="true">↗</span></a></section>
      <section class="contact" aria-labelledby="contact">
        <div><p class="eyebrow">Contact</p><h2 id="contact">Say hello.</h2><p>For anything outside the issue tracker, drop me a line.</p></div>
        <div class="contact-links"><a class="text-link" href="mailto:{{ site.email }}">{{ site.email }} <span aria-hidden="true">↗</span></a><a class="text-link" href="{{ site.linkedin }}">LinkedIn / alexgccp <span aria-hidden="true">↗</span></a></div>
      </section>
    </main>
    <footer><span>libsrc.dev</span><span>{{ site.name }}</span><a href="{{ site.github }}">GitHub ↗</a></footer>
  </div>
</body>
</html>
